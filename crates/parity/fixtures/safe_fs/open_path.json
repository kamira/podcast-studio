{
  "unit": "safe_fs.open_path",
  "cases": [
    {"id": "deep_read", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "b", "f.txt"], "flags": "r"}}},
    {"id": "top_level_read", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["top.txt"], "flags": "r"}}},
    {"id": "deep_read_write", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "b", "f.txt"], "flags": "rw"}}},
    {"id": "deep_write_truncate", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "b", "f.txt"], "flags": "w_trunc"}}},
    {"id": "empty_parts", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": [], "flags": "r"}}},
    {"id": "last_is_dir", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "b"], "flags": "r"}}},
    {"id": "missing_mid", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["nope", "f.txt"], "flags": "r"}}},
    {"id": "missing_last", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "nope"], "flags": "r"}}},
    {"id": "mid_is_file", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", "plain", "x"], "flags": "r"}}},
    {"id": "symlink_mid_out", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}, {"path": "out", "type": "symlink", "target": "@outside/d", "kind": "dir"}, {"path": "a/in", "type": "symlink", "target": "@top/a/b", "kind": "dir"}, {"path": "dang", "type": "symlink", "target": "@missing", "kind": "dir"}, {"path": "fl", "type": "symlink", "target": "@outside/marker.txt", "kind": "file"}, {"path": "a/fin", "type": "symlink", "target": "@top/a/plain", "kind": "file"}, {"path": "fdang", "type": "symlink", "target": "@missing", "kind": "file"}], "call": {"parts": ["out", "inner.txt"], "flags": "r"}}},
    {"id": "symlink_mid_in", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}, {"path": "out", "type": "symlink", "target": "@outside/d", "kind": "dir"}, {"path": "a/in", "type": "symlink", "target": "@top/a/b", "kind": "dir"}, {"path": "dang", "type": "symlink", "target": "@missing", "kind": "dir"}, {"path": "fl", "type": "symlink", "target": "@outside/marker.txt", "kind": "file"}, {"path": "a/fin", "type": "symlink", "target": "@top/a/plain", "kind": "file"}, {"path": "fdang", "type": "symlink", "target": "@missing", "kind": "file"}], "call": {"parts": ["a", "in", "f.txt"], "flags": "r"}}},
    {"id": "symlink_last", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}, {"path": "out", "type": "symlink", "target": "@outside/d", "kind": "dir"}, {"path": "a/in", "type": "symlink", "target": "@top/a/b", "kind": "dir"}, {"path": "dang", "type": "symlink", "target": "@missing", "kind": "dir"}, {"path": "fl", "type": "symlink", "target": "@outside/marker.txt", "kind": "file"}, {"path": "a/fin", "type": "symlink", "target": "@top/a/plain", "kind": "file"}, {"path": "fdang", "type": "symlink", "target": "@missing", "kind": "file"}], "call": {"parts": ["fl"], "flags": "r"}}},
    {"id": "invalid_last", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["a", ".."], "flags": "r"}}},
    {"id": "invalid_last_after_missing", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["nope", ".."], "flags": "r"}}},
    {"id": "invalid_mid", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}], "call": {"parts": ["..", "f.txt"], "flags": "r"}}},
    {"id": "top_is_symlink_followed", "input": {"tree": [{"path": "a/b", "type": "dir"}, {"path": "a/b/f.txt", "type": "file", "content": "inside"}, {"path": "a/plain", "type": "file", "content": "plain"}, {"path": "top.txt", "type": "file", "content": "top"}, {"path": "out", "type": "symlink", "target": "@outside/d", "kind": "dir"}, {"path": "a/in", "type": "symlink", "target": "@top/a/b", "kind": "dir"}, {"path": "dang", "type": "symlink", "target": "@missing", "kind": "dir"}, {"path": "fl", "type": "symlink", "target": "@outside/marker.txt", "kind": "file"}, {"path": "a/fin", "type": "symlink", "target": "@top/a/plain", "kind": "file"}, {"path": "fdang", "type": "symlink", "target": "@missing", "kind": "file"}], "call": {"top": "out", "parts": ["inner.txt"], "flags": "r"}}}
  ]
}
